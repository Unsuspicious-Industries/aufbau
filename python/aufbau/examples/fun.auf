// Fun — a functional language with modern syntax but STLC semantics.
// Monomorphic functions, no polymorphism, no recursive binder.
//
// This is the grammar where every live prefix really is completable, and it
// earns that the hard way: not with a single term that inhabits every type
// (ml.auf's `assert false : ?A`), but with a *distributed* cover — one witness
// per demanded type. Each base type is inhabited by its own zero-premise
// literal, and a function type `A -> B` by a lambda whose body inhabits `B`, so
// inhabitation is discharged by induction on the demanded type rather than by a
// single axiom.
//
// That only works if the set of demandable types is exactly the set of covered
// ones, which is why TypeName is a closed enumeration rather than an identifier
// pattern. With an open pattern like /[A-Z][a-z0-9]*/ a program could annotate a
// binder with an atom such as `Foo` that no closed term inhabits, and the prefix
// `let x : Foo =` would be live with no completion at all — the same dead end
// stlc.auf has, dressed in nicer syntax. Enumerating the base types turns that
// silent dead end into an outright refutation.
//
// Adding a base type therefore means adding its literal in the same commit.
// A constructor with no introduction form reopens the hole.

// ===================== Identifiers =====================
Identifier ::= /[a-z][a-z0-9]*/
// Closed on purpose: every name here must have a literal below. See the header.
TypeName ::= 'Int' | 'Float' | 'Bool'

// ===================== Type Annotations =====================
BaseType ::= TypeName | '(' Type ')'
FunctionType ::= BaseType '->' Type
Type* ::= BaseType | FunctionType

// ===================== Literals =====================
Integer(int) ::= /[0-9]+/
Boolean(bool) ::= 'true' | 'false'
Float(float) ::= /[0-9]+\.[0-9]+/


// ===================== Operators =====================

// Integer operators
IntOp ::= '+' | '-' | '*' | '/'

// Float operators (OCaml-style)
FloatOp ::= '+.' | '-.' | '*.' | '/.'


// ===================== Expressions =====================

// Variable reference
Variable(var) ::= Identifier[x]

// Lambda: (x: Int) => x + 1
Lambda(lambda) ::= '(' Identifier[param] ':' Type[τ] ')' '=>' Expression[body]

// Parenthesized expression
Paren ::= '(' Expression ')'

// Let binding
Let(let) ::= 'let' Identifier[name] ':' Type[τ] '=' Expression[value] ';' Expression[body]

// Atomic expressions
AtomicExpression ::= Variable
                   | Integer
                   | Float
                   | Boolean
                   | Lambda
                   | Paren

// Binary integer operation
IntBinary(bin_int) ::= Expression[left] IntOp[op] Expression[right]

// Binary float operation
FloatBinary(bin_float) ::= Expression[left] FloatOp[op] Expression[right]

// Application: each production exposes the bindings required by (app)
Application(app) ::= AtomicExpression[func] '(' Expression[arg] ')'
                   | Application[func] '(' Expression[arg] ')'

// Top-level expression
Expression ::= IntBinary
             | FloatBinary
             | Application
             | Let
             | AtomicExpression


// ===================== Typing Rules =====================

// Variable lookup
x ∈ Γ
----------- (var)
Γ(x)

// Integer literal
----------- (int)
'Int'

// Float literal
----------- (float)
'Float'

// Boolean literal
----------- (bool)
'Bool'

// Lambda
Γ[param:τ] ⊢ body : ?R
----------------------- (lambda)
τ -> ?R

// Let
Γ ⊢ value : τ, Γ[name:τ] ⊢ body : ?R
------------------------------------- (let)
?R

// Integer binary operators
Γ ⊢ left : 'Int', Γ ⊢ right : 'Int'
---------------------------------- (bin_int)
'Int'

// Float binary operators
Γ ⊢ left : 'Float', Γ ⊢ right : 'Float'
-------------------------------------- (bin_float)
'Float'

// Application
Γ ⊢ func : ?A -> ?R, Γ ⊢ arg : ?A
---------------------------------- (app)
?R
