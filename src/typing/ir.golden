# c.auf
float_lit:
  r0 = 'float'
  emit r0

# c.auf
fndef0:
  push_scope
    r0 = ret
    extend 'return' := r0
    r1 = ⊤
    ascribe body : r1
  pop_scope
  r2 = FnUnit(ret)
  effect name := r2
  r3 = ⊤
  emit r3
  splice body = [1..3]

# c.auf
fndefn:
  push_scope
    r0 = ret
    extend 'return' := r0
    r1 = ?Ps
    ascribe params : r1
  pop_scope
  r2 = Fn(?Ps, ret)
  effect name := r2
  r3 = ⊤
  emit r3
  splice params = [1..3]

# c.auf
for:
  r0 = 'void'
  ascribe init : r0
  r1 = 'int'
  ascribe cond : r1
  r2 = 'void'
  ascribe step : r2
  r3 = ?T
  ascribe body : r3
  r4 = ?T
  emit r4
  splice body = [6..6]
  splice cond = [2..2]
  splice init = [0..0]
  splice step = [4..4]

