# ml.auf
match:
  r0 = ListType(?A)
  ascribe scrutinee : r0
  r1 = ?T
  ascribe nil_case : r1
  push_scope
    r2 = ?A
    extend head := r2
    r3 = ListType(?A)
    extend tail := r3
    r4 = ?T
    ascribe cons_case : r4
  pop_scope
  r5 = ?T
  emit r5
  splice cons_case = [5..9]
  splice nil_case = [2..2]
  splice scrutinee = [0..0]

