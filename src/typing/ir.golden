  ascribe r : r1
  r2 = 'int'
  emit r2
  splice l = [0..0]
  splice r = [2..2]

# c.auf
decl:
  r0 = τ
  ascribe value : r0
  r1 = τ
  effect name := r1
  r2 = 'void'
  emit r2
  splice value = [0..0]

# c.auf
decl_no_init:
  r0 = τ
