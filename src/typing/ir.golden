# c.auf
addr:
  r0 = ?A
  ascribe e : r0
  r1 = CPointer(?A)
  emit r1
  splice e = [0..0]

# c.auf
argstep:
  r0 = ?H
  ascribe hd : r0
  r1 = ?T
  ascribe tl : r1
  r2 = ParamCons(?H, ?T)
  emit r2
  splice hd = [0..0]
  splice tl = [2..2]

# c.auf
arith:
  r0 = 'int'
  ascribe l : r0
  r1 = 'int'
  ascribe r : r1
  r2 = 'int'
  emit r2
  splice l = [0..0]
  splice r = [2..2]

# c.auf
assign:
  member name
  r0 = Γ(name)
  ascribe value : r0
  r1 = 'void'
  emit r1
  splice name = [0..0]
  splice value = [1..1]

# c.auf
call:
  member fn
  r0 = Γ(fn)
  r1 = Fn(?Ps, ?R)
  equate r0 = r1
  r2 = ?Ps
  ascribe args : r2
  r3 = ?R
  emit r3
  splice args = [4..4]
  splice fn = [0..0]

# c.auf
call_empty:
  member fn
  r0 = Γ(fn)
  r1 = FnUnit(?R)
  equate r0 = r1
  r2 = ?R
  emit r2
  splice fn = [0..0]

# c.auf
cast:
  r0 = τ
  emit r0

# c.auf
char_lit:
  r0 = 'char'
  emit r0

# c.auf
compare:
  r0 = 'int'
