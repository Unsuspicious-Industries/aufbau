// TypeScript-like typed subset.
//
// This stays inside Aufbau's current semantic algebra from p7-sas.pdf:
// finite contexts, local unification, child ascription, and right-bound
// declaration effects. Variadic-looking function calls/params are encoded with
// recursive lists that synthesize curried arrow types.

// ===================== Identifiers =====================
Identifier ::= /[a-zA-Z_][a-zA-Z0-9_]*/

// ===================== Types =====================
TypeName ::= 'number' | 'string' | 'boolean' | 'void'
BaseType ::= TypeName | '(' Type ')' | ObjectType
ArrayType ::= BaseType '[' ']'
PrimaryType ::= ArrayType | BaseType
TypeList ::= Type ',' TypeList | Type
FunctionType ::= '(' ')' '=>' Type
               | '(' TypeList ')' '=>' Type
UnionType ::= PrimaryType '|' Type
Type ::= FunctionType | UnionType | PrimaryType

ObjectTypeField ::= Identifier ':' Type
ObjectTypeFieldList ::= ObjectTypeField ',' ObjectTypeFieldList | ObjectTypeField
ObjectType ::= '{' '}' | '{' ObjectTypeFieldList '}'

// ===================== Literals =====================
NumberLit(num_lit) ::= /[0-9]+(\.[0-9]+)?/
StringLit(str_lit) ::= /"[^"]*"/
BooleanLit(bool_lit) ::= 'true' | 'false'

// ===================== Expressions =====================
Variable(var) ::= Identifier[x]

ArrayItemsOne(array_items_one) ::= Expression[item]
ArrayItemsCons(array_items_cons) ::= Expression[item] ',' ArrayItems[tail]
ArrayItems ::= ArrayItemsCons | ArrayItemsOne
ArrayLiteralEmpty(array_empty) ::= '[' ']'
ArrayLiteral(array) ::= '[' ArrayItems[items] ']'

ObjectFieldOne(obj_field_one) ::= Identifier[key] ':' Expression[value]
ObjectFieldCons(obj_field_cons) ::= Identifier[key] ':' Expression[value] ',' ObjectFields[tail]
ObjectFields ::= ObjectFieldCons | ObjectFieldOne
ObjectLiteralEmpty(object_empty) ::= '{' '}'
ObjectLiteral(object) ::= '{' ObjectFields[fields] '}'

FunctionExpr0(lambda0) ::= '(' ')' '=>' Expression[body]
FunctionExpr(lambda) ::= '(' LambdaParams[params]
LambdaParamLast(lambda_param_last) ::= Identifier[param] ':' Type[τ] ')' '=>' Expression[body]
LambdaParamCons(lambda_param_cons) ::= Identifier[param] ':' Type[τ] ',' LambdaParams[tail]
LambdaParams ::= LambdaParamCons | LambdaParamLast

Grouped ::= '(' Expression ')'

Primary ::= Variable
          | NumberLit
          | StringLit
          | BooleanLit
          | ArrayLiteralEmpty
          | ArrayLiteral
          | ObjectLiteralEmpty
          | ObjectLiteral
          | FunctionExpr0
          | FunctionExpr
          | Grouped

ArgListOne(args_one) ::= Expression[arg]
ArgListCons(args_cons) ::= Expression[arg] ',' ArgList[tail]
ArgList ::= ArgListCons | ArgListOne
CallWithArgs(call) ::= Primary[func] '(' ArgList[args] ')'
                     | Call[func] '(' ArgList[args] ')'
CallEmpty(call_empty) ::= Primary[func] '(' ')'
                       | Call[func] '(' ')'
Call ::= CallWithArgs | CallEmpty

NumberOp ::= '+' | '-' | '*' | '/'
NumberBinary(bin_num) ::= Expression[left] NumberOp[op] Expression[right]

EqualityOp ::= '===' | '!=='
Equality(eq) ::= Expression[left] EqualityOp[op] Expression[right]

CondExpr(cond_expr) ::= 'if' '(' Expression[cond] ')' Expression[then] 'else' Expression[else]

Expression ::= NumberBinary
             | Equality
             | CondExpr
             | Call
             | Primary

WhileStmt(while) ::= 'while' '(' Expression[cond] ')' Block[body]

// ===================== Statements =====================
VarDecl(decl) ::= 'let' Identifier[name] ':' Type[τ] '=' Expression[value] ';'
ConstDecl(const_decl) ::= 'const' Identifier[name] ':' Type[τ] '=' Expression[value] ';'

FunctionDecl0(function0) ::= 'function' Identifier[name] '(' ')' ':' Type[ret] '{' 'return' Expression[body] ';' '}'
FunctionDecl(function) ::= 'function' Identifier[name] '(' FunctionDeclParams[params]
FunctionDeclParamLast(function_param_last) ::= Identifier[param] ':' Type[τ] ')' ':' Type[ret] '{' 'return' Expression[body] ';' '}'
FunctionDeclParamCons(function_param_cons) ::= Identifier[param] ':' Type[τ] ',' FunctionDeclParams[tail]
FunctionDeclParams ::= FunctionDeclParamCons | FunctionDeclParamLast

ExprStmt(stmt) ::= Expression[value] ';'

Statement ::= FunctionDecl0 | FunctionDecl | VarDecl | ConstDecl | ExprStmt | WhileStmt
StatementList ::= Statement StatementList | Statement
Program ::= StatementList
start ::= Program

// ===================== Typing Rules =====================

// Variables
x ∈ Γ
----------- (var)
Γ(x)

// Literals
----------- (num_lit)
'number'

----------- (str_lit)
'string'

----------- (bool_lit)
'boolean'

// Arrays
----------- (array_empty)
?EmptyArrayElem[]

Γ ⊢ items : ?ArrayElem[]
---------------- (array)
?ArrayElem[]

Γ ⊢ item : ?ArrayOneElem
---------------------- (array_items_one)
?ArrayOneElem[]

Γ ⊢ item : ?ArrayConsElem, Γ ⊢ tail : ?ArrayConsElem[]
------------------------------------- (array_items_cons)
?ArrayConsElem[]

// Objects
----------- (object_empty)
{}

Γ ⊢ fields : ?ObjectType
---------------- (object)
?ObjectType

Γ ⊢ value : ?ObjectFieldType
---------------------- (obj_field_one)
{ key: ?ObjectFieldType }

Γ ⊢ value : ?ObjectHeadType, Γ ⊢ tail : ?ObjectRest
------------------------------------- (obj_field_cons)
{ key: ?ObjectHeadType, ...?ObjectRest }

// Function expressions: recursive params synthesize curried arrows.
Γ ⊢ body : ?Lambda0Return
---------------- (lambda0)
'void' => ?Lambda0Return

Γ ⊢ params : ?LambdaType
---------------- (lambda)
?LambdaType

Γ[param:τ] ⊢ body : ?LambdaLastReturn
---------------------------- (lambda_param_last)
τ => ?LambdaLastReturn

Γ[param:τ] ⊢ tail : ?LambdaTailType
---------------------------- (lambda_param_cons)
τ => ?LambdaTailType

// Function calls: argument lists are continuations from callee type to result.
Γ ⊢ arg : ?ArgOneType
---------------------- (args_one)
(?ArgOneType => ?ArgOneReturn) => ?ArgOneReturn

Γ ⊢ arg : ?ArgHeadType, Γ ⊢ tail : ?ArgTailFunc => ?ArgTailReturn
--------------------------------------- (args_cons)
(?ArgHeadType => ?ArgTailFunc) => ?ArgTailReturn

Γ ⊢ func : ?CallFunc, Γ ⊢ args : ?CallFunc => ?CallReturn
-------------------------------------- (call)
?CallReturn

Γ ⊢ func : 'void' => ?CallEmptyReturn
------------------------- (call_empty)
?CallEmptyReturn

// Numeric operators
Γ ⊢ left : 'number', Γ ⊢ right : 'number'
------------------------------------------ (bin_num)
'number'

// Strict equality: both sides must be compatible.
Γ ⊢ left : ?EqType, Γ ⊢ right : ?EqType
----------------------------- (eq)
'boolean'

// Conditional expression
Γ ⊢ cond : 'boolean', Γ ⊢ then : ?T, Γ ⊢ else : ?T
-------------------------------------------------- (cond_expr)
?T

// Variable declarations export a right-bound context transform.
Γ ⊢ value : τ
----------------------- (decl)
Γ → Γ[name:τ] ⊢ 'void'

Γ ⊢ value : τ
---------------------------- (const_decl)
Γ → Γ[name:τ] ⊢ 'void'

// Function0: body sees name: 'void' => ret so the function can call itself.
Γ[name:'void' => ret] ⊢ body : ret
------------------------------- (function0)
Γ → Γ[name:'void' => ret] ⊢ 'void'

// Function: body sees name: ?FunctionType so the function can call itself.
Γ ⊢ params : ?FunctionType
Γ[name:?FunctionType] ⊢ body : ret
------------------------------- (function)
Γ → Γ[name:?FunctionType] ⊢ 'void'

// Function params: each param extends context; tail chains; body sees everything.
Γ[param:τ] ⊢ body : ret
------------------------------- (function_param_last)
τ => ret

Γ[param:τ] ⊢ tail : ?FunctionTailType
------------------------------- (function_param_cons)
τ => ?FunctionTailType

// Expression statements are type-checked for validity and produce void.
Γ ⊢ value : ?StmtType
-------------- (stmt)
'void'

// While loop
Γ ⊢ cond : 'boolean', Γ ⊢ body : ?T
----------------------------------- (while)
?T
